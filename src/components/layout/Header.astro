---
import LanguageSwitcher from './LanguageSwitcher.astro';
import type { Lang } from '../../i18n';
import { useTranslations, localePath } from '../../i18n';

interface Props {
  lang?: Lang;
  pathWithoutLocale?: string;
}

const { lang = 'en', pathWithoutLocale = '/' } = Astro.props;
const t = useTranslations(lang);
const p = (path: string) => localePath(path, lang);
---

<header class="site-header">
  <div class="container-wide header-inner">
    <a href={p('/')} class="site-logo">
      <span class="logo-year">1945</span>
      <span class="logo-text">Echoes of 1945</span>
    </a>
    <nav class="site-nav" aria-label="Main navigation">
      <ul>
        <li><a href={p('/events/')}>{t.nav.events}</a></li>
        <li><a href={p('/people/')}>{t.nav.people}</a></li>
        <li><a href={p('/conferences/')}>{t.nav.conferences}</a></li>
        <li><a href={p('/technology/')}>{t.nav.technology}</a></li>
        <li><a href={p('/war-crimes/')}>{t.nav.warCrimes}</a></li>
        <li><a href={p('/settlements/')}>{t.nav.settlements}</a></li>
        <li><a href={p('/aftermath/')}>{t.nav.aftermath}</a></li>
        <li><a href={p('/stats/')}>{t.nav.stats}</a></li>
        <li><a href={p('/timeline/')}>{t.nav.timeline}</a></li>
      </ul>
    </nav>
    <LanguageSwitcher lang={lang} pathWithoutLocale={pathWithoutLocale} />
  </div>
</header>

<style>
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: var(--color-bg);
  border-bottom: 1px solid var(--color-border);
  padding: var(--space-2) 0;
}

.header-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: var(--space-4);
}

.site-logo {
  display: flex;
  align-items: baseline;
  gap: var(--space-2);
  text-decoration: none;
  color: var(--color-text);
  flex-shrink: 0;
}

.logo-year {
  font-family: var(--font-mono);
  font-size: 0.75rem;
  font-weight: 500;
  color: var(--color-accent);
  letter-spacing: 0.1em;
}

.logo-text {
  font-family: var(--font-serif);
  font-size: 1.125rem;
  font-weight: 700;
}

.site-nav ul {
  display: flex;
  list-style: none;
  padding: 0;
  margin: 0;
  gap: var(--space-4);
}

.site-nav a {
  font-family: var(--font-body);
  font-size: 0.9rem;
  color: var(--color-text-muted);
  text-decoration: none;
  transition: color 0.2s ease;
}

.site-nav a:hover {
  color: var(--color-accent);
  text-decoration: none;
}

@media (max-width: 768px) {
  .site-nav {
    display: none;
  }
}
</style>
