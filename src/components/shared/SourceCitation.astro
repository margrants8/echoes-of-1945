---
import type { Lang } from '../../i18n';
import { useTranslations } from '../../i18n';

interface Source {
  title: string;
  url?: string;
  author?: string;
  publisher?: string;
  year?: number;
  page?: string;
  type?: string;
}

interface Props {
  sources: Source[];
  lang?: Lang;
}

const { sources, lang = 'en' } = Astro.props;
const t = useTranslations(lang);

function meta(s: Source): string {
  return [s.publisher, s.year, s.page].filter(Boolean).join(', ');
}
---

{sources.length > 0 && (
  <aside class="source-citation">
    <h4 class="source-citation__title">{t.ui.source}</h4>
    <ol class="source-citation__list">
      {sources.map(s => (
        <li>
          {s.author && <span class="source-author">{s.author}. </span>}
          {s.url
            ? <a href={s.url} target="_blank" rel="noopener noreferrer">{s.title}</a>
            : <span>{s.title}</span>
          }
          {meta(s) && <span class="source-meta"> — {meta(s)}</span>}
        </li>
      ))}
    </ol>
  </aside>
)}

<style>
.source-citation {
  margin-top: var(--space-6);
  padding: var(--space-3);
  border: 1px solid var(--color-border);
  background: var(--color-bg-elevated);
  border-radius: 3px;
}

.source-citation__title {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--color-text-muted);
  margin-bottom: var(--space-2);
}

.source-citation__list {
  padding-left: var(--space-3);
  margin: 0;
}

.source-citation__list li {
  font-size: 0.85rem;
  color: var(--color-text-muted);
  margin-bottom: var(--space-1);
  font-family: var(--font-body);
}

.source-author {
  font-style: italic;
}

.source-meta {
  font-family: var(--font-mono);
  font-size: 0.78rem;
}
</style>
