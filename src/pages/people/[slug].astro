---
import BaseLayout from '../../components/layout/BaseLayout.astro';
import Header from '../../components/layout/Header.astro';
import Footer from '../../components/layout/Footer.astro';
import SourceCitation from '../../components/shared/SourceCitation.astro';
import { getCollection, render } from 'astro:content';
import { useTranslations, localePath } from '../../i18n';

export async function getStaticPaths() {
  const allPeople = await getCollection('people');
  return allPeople
    .filter(e => e.id.startsWith('en/'))
    .map(person => ({
      params: { slug: person.id.replace('en/', '') },
      props: { person },
    }));
}

const lang = 'en';
const t = useTranslations(lang);
const p = (path: string) => localePath(path, lang);

const { person } = Astro.props;
const { Content } = await render(person);
const slug = person.id.replace('en/', '');
---

<BaseLayout title={person.data.name} lang={lang}>
  <Header slot="header" lang={lang} pathWithoutLocale={`/people/${slug}/`} />
  <article class="person-article container-text">
    <header class="person-header">
      <div class="person-breadcrumb">
        <a href={p('/people/')}>{t.nav.people}</a>
        <span>›</span>
        <span>{t.people.side[person.data.side]}</span>
      </div>
      <h1 class="person-name">{person.data.name}</h1>
      <dl class="person-meta">
        <div><dt>{t.people.nationality}</dt><dd>{person.data.nationality}</dd></div>
        <div><dt>{t.people.identity}</dt><dd>{t.people.side[person.data.side]}</dd></div>
        <div><dt>{t.people.role}</dt><dd>{person.data.role}</dd></div>
        <div>
          <dt>{t.people.lifespan}</dt>
          <dd>{person.data.born}{person.data.died ? ` — ${person.data.died}` : ''}</dd>
        </div>
      </dl>
    </header>
    <div class="person-body"><Content /></div>
    {person.data.sources && person.data.sources.length > 0 && (
      <SourceCitation sources={person.data.sources} lang={lang} />
    )}
  </article>
  <Footer slot="footer" lang={lang} />
</BaseLayout>

<style>
.person-article { padding: var(--space-8) var(--space-4); }
.person-breadcrumb {
  display: flex; align-items: center; gap: var(--space-1);
  font-size: 0.85rem; color: var(--color-text-muted);
  margin-bottom: var(--space-4); font-family: var(--font-mono);
}
.person-breadcrumb a { color: var(--color-text-muted); }
.person-name { margin-bottom: var(--space-4); }
.person-meta {
  display: flex; flex-wrap: wrap; gap: var(--space-4);
  padding: var(--space-3); background: var(--color-bg-elevated);
  border: 1px solid var(--color-border); border-radius: 3px; margin-bottom: var(--space-6);
}
.person-meta div { display: flex; flex-direction: column; }
.person-meta dt { font-size: 0.7rem; font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.05em; color: var(--color-text-muted); margin-bottom: 0.2em; }
.person-meta dd { font-size: 0.95rem; font-weight: 600; }
.person-body { font-family: var(--font-body); font-size: clamp(1rem, 1.5vw, 1.125rem); line-height: 1.85; }
</style>
